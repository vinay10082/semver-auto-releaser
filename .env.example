# GitHub token with permission to create releases (only needed if CREATE_GITHUB_RELEASE=true)
GITHUB_TOKEN=

# Repository the release should be published to (only needed if CREATE_GITHUB_RELEASE=true)
REPO_OWNER=
REPO_NAME=

# Git remote and branch used when PUSH_TAGS=true
GIT_REMOTE=origin
DEFAULT_BRANCH=main

# Files the releaser reads/writes
VERSION_FILE=pyproject.toml
CHANGELOG_FILE=CHANGELOG.md

# Prefix used for git tags, e.g. v1.2.3
TAG_PREFIX=v

# Preview a release without writing files, committing, tagging, or pushing
DRY_RUN=false

# Push the release commit and tag to GIT_REMOTE after a successful release
PUSH_TAGS=false

# Publish a GitHub Release via the API after a successful release
CREATE_GITHUB_RELEASE=false
